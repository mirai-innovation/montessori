# Server
PORT=5001
# Local (requiere MongoDB instalado y corriendo):
# MONGO_URI=mongodb://localhost:27017/montessori
# MongoDB Atlas (recomendado — gratis):
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/montessori?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Email (Gmail). Si faltan, los correos solo se registran en la consola.
# EMAIL_PASS = contraseña de aplicación de Google (myaccount.google.com/apppasswords), NO la contraseña normal
EMAIL_USER=adrianavillalobosmontessorijp@gmail.com
EMAIL_PASS=
# A dónde llegan los avisos de citas, pagos y registros (por defecto, EMAIL_USER)
# ADMIN_NOTIFY_EMAIL=

# Admin seed (first run)
ADMIN_EMAIL=adriana@ejemplo.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Adriana Villalobos

# Stripe Phase 2 (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Los precios viven en shared/content.js (servicePlans); no hace falta crear precios en Stripe

# Frontend (solo si API está en otro dominio; en Vercel dejar vacío)
# VITE_API_URL=
